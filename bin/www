#!/usr/bin/env node

import http from "http"
import mongoose from "mongoose"
import dotenv from "dotenv"

import app from "../app.js"
import { Server } from "socket.io"
import jwt from "jsonwebtoken"

import gameSocketHandler from "../sockets/gameSocketHandler.js"
import authMiddleware from "../middlewares/authMiddleware.js"

dotenv.config()

const port = normalizePort(process.env.PORT || "4000")
app.set("port", port)

const server = http.createServer(app)

server.listen(port)
server.on("listening", onListening)

// create IO object, allow all CORS requests
const io = new Server(server, {
  cors: { origin: "*" },
})

io.use(authMiddleware)

io.on("connection", (socket) => {
  gameSocketHandler(socket, io)
})

const uri = process.env.ATLAS_URI
mongoose.connect(uri)
mongoose.set("strictQuery", false)

const connection = mongoose.connection
connection.once("open", () => console.log("Connected to db"))

function normalizePort(val) {
  let portNum = parseInt(val, 10)

  if (isNaN(portNum)) return val
  if (portNum >= 0) return portNum

  return false
}

function onListening() {
  const addr = server.address()
  let bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port
  console.log("Listening on " + bind + "...")
}
